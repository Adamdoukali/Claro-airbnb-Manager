# Dependencies
node_modules/
*/node_modules/

# Production build
client/dist/
dist/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite.config.js.timestamp*

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# User generated files (uploads and pdfs)
server/uploads/*
!server/uploads/.gitkeep
server/generated_pdfs/*
!server/generated_pdfs/.gitkeep

# IDE
.vscode/
.idea/

# Local database (contains guest data) - use Supabase in production
server/data.json
server/data.json.tmp

# Vercel
.vercel

.vercel
.env*

# Keep the documented example (the .env* rule above would hide it)
!server/.env.example
!.env.example
