# ---- Serveur ----
PORT=5000
NODE_ENV=development
# URL publique de l'application (obligatoire en production, ex: https://airbnb.clarodigi.com)
APP_URL=

# ---- Authentification ----
# Secret de signature des sessions (obligatoire en production) : openssl rand -hex 32
JWT_SECRET=
# Compte administrateur créé automatiquement au premier démarrage (si aucun utilisateur n'existe)
ADMIN_EMAIL=doukali@gmail.com
ADMIN_PASSWORD=
SESSION_DAYS=7

# ---- Supabase (base de données + stockage fichiers) ----
# Laisser vide pour le mode local (server/data.json + disque).
# Supabase > Project Settings > API : Project URL et "service_role" secret key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=claro-files

# ---- Hospitable ----
# Personal Access Token (peut aussi être saisi dans l'interface)
HOSPITABLE_API_KEY=
# Secret du webhook Hospitable (Settings > Apps & API > Webhooks) pour vérifier la signature
HOSPITABLE_WEBHOOK_SECRET=

# ---- Automatisations (messages automatiques, rappels, synchro planifiée) ----
# Vercel : secret envoyé par Vercel Cron à GET /api/automation/run (openssl rand -hex 24)
CRON_SECRET=
# Serveur classique (Render, VPS) : passage automatique interne en minutes (0 = désactivé ; défaut 60 en production)
AUTOMATION_INTERVAL_MINUTES=

# ---- PDF ----
# Chemin explicite vers Chrome/Edge/Chromium si non détecté automatiquement
CHROME_PATH=

# Origines supplémentaires autorisées (CORS), séparées par des virgules
CORS_ORIGINS=
